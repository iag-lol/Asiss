# El backend principal de ASISS se define en src/shared/lib/supabaseConfig.ts.
# No se configura con variables de GitHub Actions.

# Instancia Supabase independiente para el módulo Mini-Check.
# No reutiliza ni hereda las credenciales principales.
VITE_MINICHECK_SUPABASE_URL=
VITE_MINICHECK_SUPABASE_ANON_KEY=

# Variables para función Edge (Supabase) de envío de correo
RESEND_API_KEY=
RESEND_FROM=notificaciones@asiss.online
RESEND_FALLBACK_TO=tu@correo.com,otro@correo.com
RESEND_BRAND_URL=https://asiss.online
